def them_ban_ghi(ds):
    print("\n" + "=" * 70)
    print("                 THÊM BẢN GHI MỚI")
    print("=" * 70)

    while True:
        ma_tai_lieu = nhap_chuoi_bat_buoc("Mã tài liệu: ")

        if tim_theo_ma(ds, ma_tai_lieu) is not None:
            print("Lỗi: Mã tài liệu đã tồn tại!")
        else:
            break

    ten_tai_lieu = nhap_chuoi_bat_buoc("Tên tài liệu: ")
    mon_hoc = nhap_chuoi_bat_buoc("Môn học: ")
    loai_tai_lieu = nhap_chuoi_bat_buoc("Loại tài liệu: ")

    so_trang = nhap_so_nguyen("Số trang: ", 1)
    muc_do = nhap_muc_do()
    ngay_tao = nhap_ngay("Ngày tạo (YYYY-MM-DD): ")

    while True:
        ma_lich = nhap_chuoi_bat_buoc("Mã lịch: ")

        # Kiểm tra mã lịch không trùng
        trung = False

        for item in ds:
            if item["ma_lich"].lower() == ma_lich.lower():
                trung = True
                break

        if trung:
            print("Lỗi: Mã lịch đã tồn tại!")
        else:
            break

    ngay_on = nhap_ngay("Ngày ôn (YYYY-MM-DD): ")
    thoi_gian = nhap_gio("Thời gian ôn (HH:MM): ")
    noi_dung = nhap_chuoi_bat_buoc("Nội dung ôn: ")
    thoi_luong = nhap_so_nguyen("Thời lượng (phút): ", 1)
    trang_thai = nhap_trang_thai()

    # Kiểm tra logic
    if trang_thai == "Đã hoàn thành":
        print("Bản ghi được đánh dấu đã hoàn thành.")

    item = {
        "ma_tai_lieu": ma_tai_lieu,
        "ten_tai_lieu": ten_tai_lieu,
        "mon_hoc": mon_hoc,
        "loai_tai_lieu": loai_tai_lieu,
        "so_trang": so_trang,
        "muc_do": muc_do,
        "ngay_tao": ngay_tao,
        "ma_lich": ma_lich,
        "ngay_on": ngay_on,
        "thoi_gian": thoi_gian,
        "noi_dung": noi_dung,
        "thoi_luong": thoi_luong,
        "trang_thai": trang_thai
    }

    ds.append(item)

    print("\nThêm bản ghi thành công!")


