            thong_ke_muc_do(ds)

        elif choice == "4":
            thong_ke_trang_thai(ds)

        elif choice == "5":
            canh_bao_lich_trung(ds)

        elif choice == "0":
            break

        else:
            print("Lựa chọn không hợp lệ!")


# ============================================================
# 20. LƯU DỮ LIỆU VÀO FILE TXT
# ============================================================

def luu_du_lieu(ds, filename="data.txt"):
    try:
        with open(filename, "w", encoding="utf-8") as file:

            for item in ds:
                line = "|".join([
                    item["ma_tai_lieu"],
                    item["ten_tai_lieu"],
                    item["mon_hoc"],
                    item["loai_tai_lieu"],
                    str(item["so_trang"]),
                    item["muc_do"],
                    item["ngay_tao"],
                    item["ma_lich"],
                    item["ngay_on"],
                    item["thoi_gian"],
                    item["noi_dung"],
                    str(item["thoi_luong"]),
                    item["trang_thai"]
                ])

                file.write(line + "\n")

        print(f"Lưu dữ liệu thành công vào file {filename}!")

    except PermissionError:
        print("Lỗi: Không có quyền ghi file.")

    except OSError as e:
        print("Lỗi khi ghi file:", e)


# ============================================================
# 21. ĐỌC DỮ LIỆU TỪ FILE TXT
# ============================================================

def doc_du_lieu(filename="data.txt"):
    ds = []

    try:
        with open(filename, "r", encoding="utf-8") as file:

            for line_number, line in enumerate(file, 1):

                line = line.strip()

                if line == "":
                    continue

                parts = line.split("|")

                if len(parts) != 13:
                    print(
                        f"Cảnh báo: Dòng {line_number} "
                        f"không đúng định dạng."
                    )
                    continue

                try:
                    item = {
                        "ma_tai_lieu": parts[0],
                        "ten_tai_lieu": parts[1],
                        "mon_hoc": parts[2],
                        "loai_tai_lieu": parts[3],
                        "so_trang": int(parts[4]),
                        "muc_do": parts[5],
                        "ngay_tao": parts[6],
                        "ma_lich": parts[7],
                        "ngay_on": parts[8],
                        "thoi_gian": parts[9],
                        "noi_dung": parts[10],
                        "thoi_luong": int(parts[11]),
                        "trang_thai": parts[12]
                    }

                    ds.append(item)

                except ValueError:
                    print(
                        f"Cảnh báo: Không thể chuyển kiểu dữ liệu "
                        f"ở dòng {line_number}."
                    )

        print(f"Đọc dữ liệu thành công: {len(ds)} bản ghi.")

    except FileNotFoundError:
        print(f"Không tìm thấy file {filename}.")
        print("Chương trình sẽ sử dụng danh sách rỗng.")

    except PermissionError:
        print("Lỗi: Không có quyền đọc file.")

    except OSError as e:
        print("Lỗi khi đọc file:", e)

    return ds


