# 14. THỐNG KÊ THỜI GIAN ÔN THEO MÔN
# ============================================================

def thong_ke_thoi_gian_theo_mon(ds):
    thong_ke = {}

    for item in ds:
        mon = item["mon_hoc"]

        if mon not in thong_ke:
            thong_ke[mon] = 0

        thong_ke[mon] += item["thoi_luong"]

    print("\n" + "=" * 55)
    print("             THỜI GIAN ÔN THEO MÔN")
    print("=" * 55)

    if len(thong_ke) == 0:
        print("Chưa có dữ liệu.")
        return

    for mon, tong_phut in thong_ke.items():
        gio = tong_phut // 60
        phut = tong_phut % 60

        print(f"{mon:<30} : {gio} giờ {phut} phút")


# ============================================================
# 15. THỐNG KÊ TÀI LIỆU THEO MỨC ĐỘ
# ============================================================

def thong_ke_muc_do(ds):
    thong_ke = {
        "Dễ": 0,
        "Trung bình": 0,
        "Khó": 0
    }

    for item in ds:
        muc_do = item["muc_do"]

        if muc_do in thong_ke:
            thong_ke[muc_do] += 1

    print("\n" + "=" * 45)
    print("              TÀI LIỆU THEO MỨC ĐỘ")
    print("=" * 45)

    for muc_do, so_luong in thong_ke.items():
        print(f"{muc_do:<20}: {so_luong} tài liệu")


