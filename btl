def thong_ke_thoi_gian_theo_mon(ds):
    thong_ke = {}

    for item in ds:
        mon = item["mon_hoc"]

        if mon not in thong_ke:
            thong_ke[mon] = 0

        thong_ke[mon] += item["thoi_luong"]

    print("\n" + "=" * 55)
    print("             THỜI GIAN ÔN THEO MÔN")
    print("=" * 55)

    if len(thong_ke) == 0:
        print("Chưa có dữ liệu.")
        return

    for mon, tong_phut in thong_ke.items():
        gio = tong_phut // 60
        phut = tong_phut % 60

        print(f"{mon:<30} : {gio} giờ {phut} phút")


