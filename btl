def sap_xep(ds):
    if len(ds) == 0:
        print("Danh sách trống!")
        return

    print("\n" + "=" * 60)
    print("                    SẮP XẾP")
    print("=" * 60)
    print("1. Theo ngày tạo")
    print("2. Theo số trang")
    print("3. Theo ngày/giờ ôn")
    print("4. Theo mức độ")
    print("0. Quay lại")

    choice = input("Lựa chọn: ").strip()

    if choice == "0":
        return

    print("\n1. Tăng dần")
    print("2. Giảm dần")

    order = input("Chọn kiểu sắp xếp: ").strip()

    if order not in ["1", "2"]:
        print("Lựa chọn không hợp lệ!")
        return

    reverse = order == "2"

    if choice == "1":
        ds.sort(key=lambda x: x["ngay_tao"], reverse=reverse)

    elif choice == "2":
        ds.sort(key=lambda x: x["so_trang"], reverse=reverse)

    elif choice == "3":
        ds.sort(
            key=lambda x: datetime.strptime(
                x["ngay_on"] + " " + x["thoi_gian"],
                "%Y-%m-%d %H:%M"
            ),
            reverse=reverse
        )

    elif choice == "4":
        muc_do_value = {
            "Dễ": 1,
            "Trung bình": 2,
            "Khó": 3
        }

        ds.sort(
            key=lambda x: muc_do_value[x["muc_do"]],
            reverse=reverse
        )

    else:
        print("Lựa chọn không hợp lệ!")
        return

    print("\nSắp xếp thành công!")
    hien_thi_danh_sach(ds)


