def canh_bao_lich_trung(ds):
    print("\n" + "=" * 65)
    print("                   CẢNH BÁO LỊCH TRÙNG")
    print("=" * 65)

    da_trung = False

    for i in range(len(ds)):
        for j in range(i + 1, len(ds)):

            lich_1 = ds[i]
            lich_2 = ds[j]

            if (
                lich_1["ngay_on"] == lich_2["ngay_on"]
                and lich_1["thoi_gian"] == lich_2["thoi_gian"]
            ):
                da_trung = True

                print("\nPhát hiện lịch trùng:")
                print(
                    f"- {lich_1['ma_tai_lieu']} - "
                    f"{lich_1['ten_tai_lieu']}"
                )

                print(
                    f"- {lich_2['ma_tai_lieu']} - "
                    f"{lich_2['ten_tai_lieu']}"
                )

                print(
                    f"Thời gian: "
                    f"{lich_1['ngay_on']} "
                    f"{lich_1['thoi_gian']}"
                )

    if not da_trung:
        print("Không phát hiện lịch ôn bị trùng.")


