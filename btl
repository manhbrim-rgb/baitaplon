def cap_nhat(ds):
    print("\n" + "=" * 60)
    print("                    CẬP NHẬT")
    print("=" * 60)

    ma = input("Nhập mã tài liệu cần cập nhật: ").strip()

    item = tim_theo_ma(ds, ma)

    if item is None:
        print("Không tìm thấy tài liệu có mã:", ma)
        return

    hien_thi_chi_tiet(item)

    print("\nNhập thông tin mới:")

    item["ten_tai_lieu"] = nhap_chuoi_bat_buoc("Tên tài liệu mới: ")
    item["mon_hoc"] = nhap_chuoi_bat_buoc("Môn học mới: ")
    item["loai_tai_lieu"] = nhap_chuoi_bat_buoc("Loại tài liệu mới: ")
    item["so_trang"] = nhap_so_nguyen("Số trang mới: ", 1)
    item["muc_do"] = nhap_muc_do()
    item["ngay_tao"] = nhap_ngay("Ngày tạo mới: ")
    item["ngay_on"] = nhap_ngay("Ngày ôn mới: ")
    item["thoi_gian"] = nhap_gio("Thời gian mới: ")
    item["noi_dung"] = nhap_chuoi_bat_buoc("Nội dung mới: ")
    item["thoi_luong"] = nhap_so_nguyen("Thời lượng mới: ", 1)
    item["trang_thai"] = nhap_trang_thai()

    print("\nCập nhật thành công!")


